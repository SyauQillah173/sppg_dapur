# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# upload nota (isi runtime, bukan artefak repo)
/public/uploads/

# ── Kredensial, Catatan Pribadi & Dokumen Rahasia (STRICTLY FORBIDDEN FROM GIT) ──
# Seluruh file .txt (catatan, password, token) di root & subfolder
*.txt
*.local.txt
/KREDENSIAL-BARU.txt
CATATAN*
catatan*
NOTES*
notes*
secrets/
private/
credentials/

# Kunci kriptografi, sertifikat, dan privat key
*.key
*.pem
*.cert
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*

# Database lokal, dump SQL, backup & folder data lokal
/.data/
/data/
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
*.backup
*.bak
*.old

# Data ekspor / spreadsheet mentah lokal
*.csv
*.xlsx
*.xls

# Log sistem & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# typescript & build info
*.tsbuildinfo
next-env.d.ts

