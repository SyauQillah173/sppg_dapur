# GiziFlow Enterprise - Environment Configuration
# Neon PostgreSQL Connection String (Ganti dengan kredensial database Anda sendiri)
DATABASE_URL="postgresql://username:your_strong_password@your-database-host.neon.tech/neondb?sslmode=require"

# Next.js Application Environment
NEXT_PUBLIC_APP_NAME="GiziFlow Enterprise"
NEXT_PUBLIC_APP_TAGLINE="Sistem Manajemen Operasional, Logistik & Keuangan SPPG"
NEXT_PUBLIC_DEFAULT_ROLE="SUPERADMIN"
